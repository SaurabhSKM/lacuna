# Choose one provider and fill in its key. "groq" is the default.
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative provider (set LLM_PROVIDER=gemini to use this instead)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Embedding model (runs locally via ONNX, no key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=4

# Enrichment loop
MAX_ENRICHMENT_ITERATIONS=2
WEB_SEARCH_RESULTS=3

# Observability (optional - leave blank to disable tracing entirely)
# Free tier available at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
