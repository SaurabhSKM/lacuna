{
  // A virtualenv for this project is ~20,000 files. Left unexcluded it
  // dominates the file watcher, Quick Open, and project-wide search -
  // and before it was gitignored it buried the Source Control panel
  // under 20k pending changes. These three lists are the editor-side
  // equivalent of .gitignore: watching, searching, and browsing.
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/chroma_db/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/chroma_db": true
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },

  // Point the editor at the project's own interpreter, so tests and
  // imports resolve without anyone selecting it by hand.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"]
}
