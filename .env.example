# Choose one provider and fill in its key. "groq" is the default.
# "stub" is an offline, deterministic provider used by the test suite and
# for wiring checks - it needs no key and produces no real answers.
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative provider (set LLM_PROVIDER=gemini to use this instead)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LLM_TEMPERATURE=0.1
# Attempts, not retries: 1 means "try once, don't retry". A failed
# attempt is re-prompted with the validation error attached, and
# transient failures (429s, timeouts) back off exponentially.
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_SECONDS=1.0

# Embedding model (runs locally via ONNX, no key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=4
# Fuse vector search with BM25 lexical search. Set false for vector only.
HYBRID_RETRIEVAL=true
# How deep each retriever goes before the two rankings are fused.
CANDIDATE_K=12
RRF_K=60
# Chunks with neither enough semantic relevance nor enough lexical
# evidence are dropped before reaching the prompt, so an off-topic
# question retrieves nothing instead of four irrelevant chunks. 0
# disables the gate. See `python eval/retrieval_eval.py --sweep` for how
# this default was chosen - it is corpus-dependent.
MIN_RELEVANCE=0.4
# Cross-encoder reranking of the fused candidates. Hybrid retrieval
# decides what gets into the candidate pool (recall); the reranker reads
# question and chunk together to decide the order and what survives the
# gate (precision). Local ONNX, no API key, ~90MB on first use.
#
# Off by default because it was measured and lost on this corpus: -8
# points of hit@k for +15 of precision, which is the wrong trade when a
# gated-out chunk sends an answerable question to web search. Worth
# re-measuring on a larger corpus - see eval/retrieval_eval.py.
RERANK=false
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# When reranking is on the gate reads the reranker's score instead of
# vector distance, so it has its own threshold.
RERANK_MIN_SCORE=0.05

# Clarification loop
# How many times the system may come back asking you to disambiguate
# before it stops asking and answers as best it can. Same reasoning as
# the enrichment cap: "still ambiguous" is not a reason to keep a user
# answering questions forever.
MAX_CLARIFICATIONS=2
# How long an unanswered clarification request stays resumable, and how
# many may be outstanding at once (the store is in-process; see the
# README note about running more than one replica).
CLARIFICATION_TTL_SECONDS=3600
MAX_PENDING_CLARIFICATIONS=1000

# Enrichment loop
MAX_ENRICHMENT_ITERATIONS=2
WEB_SEARCH_RESULTS=3
# On accept, persist only the web results the answer actually cited.
PERSIST_ONLY_CITED=true

# Observability (optional - leave blank to disable tracing entirely)
# Free tier available at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Service
PERSIST_DIR=./chroma_db
# Comma-separated allowed origins. Empty means no CORS middleware at all,
# which is the right default for a service with no browser frontend.
CORS_ORIGINS=
MAX_UPLOAD_BYTES=26214400
